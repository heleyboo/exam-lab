# --- Spike trích xuất đề ---
# Bắt buộc. Có thể dùng `ant auth login` thay cho biến này.
ANTHROPIC_API_KEY=

# Model trích xuất. Mặc định claude-opus-5 (chính xác nhất).
# Đổi sang claude-sonnet-5 để giảm khoảng 40% chi phí khi quét số lượng lớn.
SPIKE_MODEL=claude-opus-5

# Model dò hướng trang. Việc này chỉ cần nhìn hình dạng dòng chữ nên model nhỏ là đủ.
SPIKE_ORIENTATION_MODEL=claude-haiku-4-5

# DPI render trang PDF. 200 đủ cho PDF số; bản scan thử thêm 300.
SPIKE_DPI=200

# Tiền xử lý ảnh cho bản scan: auto | on | off
SPIKE_PREPROCESS=auto

# Tỉ giá quy đổi chi phí sang VND cho báo cáo spike
SPIKE_USD_VND=26000

# --- Ứng dụng web ---
# Cổng 5435 và 9100 để không đụng Postgres/MinIO của dự án khác trên cùng máy.
DATABASE_URL=postgres://examlab:examlab@localhost:5435/examlab

# Sinh bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tuỳ chọn: thiếu hai biến này thì chỉ đăng nhập bằng email/mật khẩu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO khi chạy máy dev, Cloudflare R2 khi lên production.
S3_ENDPOINT=http://localhost:9100
S3_REGION=auto
S3_BUCKET=examlab
S3_ACCESS_KEY=examlab
S3_SECRET_KEY=examlab123
